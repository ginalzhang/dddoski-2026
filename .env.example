YOUTUBE_API_KEY=your_youtube_api_key_here
# Optional. Defaults shown; load these into your process environment.
DISCOVERY_DEADLINE_SECONDS=45
YOUTUBE_REQUEST_TIMEOUT_SECONDS=5
YOUTUBE_SEARCH_CALLS_PER_REQUEST=8
YOUTUBE_DAILY_SEARCH_CALLS=90
YOUTUBE_DAILY_METADATA_CALLS=9000
YOUTUBE_QUOTA_DB=.cache/quota.sqlite3
DISCOVERY_MAX_CONCURRENT_REQUESTS=4
# Requests for more than ten results use these larger per-request limits.
YOUTUBE_LARGE_REQUEST_SEARCH_CALLS=20
YOUTUBE_LARGE_REQUEST_VERIFICATION_LIMIT=400
YOUTUBE_HTTP_CONCURRENCY=24
