# Shorts Gatekeeper Web - copy to .env.local. Every variable is optional:
# with nothing set the app runs in curated mode with the in-memory store.

# --- Fun feed -------------------------------------------------------------
# generated | curated. If APIFY_TOKEN or ANTHROPIC_API_KEY is missing, curated is forced.
FUN_FEED_MODE=curated
APIFY_TOKEN=
ANTHROPIC_API_KEY=
# Comma-separated discovery sources for generated mode: channel:<name>, keyword:<q>, hashtag:<tag>
FUN_SOURCES=channel:MrBeast,keyword:funny shorts,hashtag:shorts
# metadata-then-pass (default) | fail-closed
NO_TRANSCRIPT_POLICY=metadata-then-pass
# Spend controls (USD). Spend is tracked in memory per UTC day.
DAILY_SPEND_CAP_USD=5
APIFY_DISCOVERY_MAX_USD=0.25
APIFY_TRANSCRIPT_USD_PER_ID=0.005
# Used only for spend accounting; set these to the current Claude rates.
LLM_USD_PER_MTOK_IN=5
LLM_USD_PER_MTOK_OUT=25

# --- Custom video lists (optional, see README "Customizing the videos") ----
FUN_LINKS_PATH=data/fun-links.json
EDU_LINKS_PATH=data/edu-links.json
TRANSCRIPTS_PATH=data/transcripts.json

# --- YouTube --------------------------------------------------------------
# Optional. Enables Data API videos.list checks in `npm run seed:verify` and the admin button.
YOUTUBE_API_KEY=

# --- Storage --------------------------------------------------------------
# The MVP uses an in-memory store. STORE_PERSIST=1 also writes it to .data/store.json.
STORE_PERSIST=0
# Reserved for the Postgres/Supabase adapter, which is NOT wired yet (see README).
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=

# --- Admin ----------------------------------------------------------------
ADMIN_PASSWORD=change-me

# --- Game rules -----------------------------------------------------------
# 1 lets a user leave Study Hall after MAX_REELS_PER_VISIT reels (off by default)
STUDY_HALL_ESCAPE=0
MAX_REELS_PER_VISIT=6
# Fraction of a Short that must be watched before Next is allowed
MIN_WATCH_FRACTION=0.7
# Seconds to answer a quiz. An answer after expiry counts as wrong.
ANSWER_TIMEOUT_SEC=30
# Most reels Study Hall can require in one visit
MAX_REQUIRED=3
# Most Brain Credits a session can earn per day
CREDITS_PER_DAY=5
# Per-session API rate limit
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=10000
